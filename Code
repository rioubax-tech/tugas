<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portofolio Kelompok Kami</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <header>
        <h1>Tim Kreatif Kelompok 1</h1>
        <p>Mengenal lebih dekat 6 anggota tim di balik proyek kami.</p>
    </header>

    <main class="container">
        <section class="team-grid">
            
            <!-- Anggota 1 -->
            <div class="card">
                <img src="img/anggota1.jpg" alt="Foto Anggota 1">
                <h2>Nama Anggota 1</h2>
                <span class="role">Ketua Kelompok & Frontend</span>
                <p>Bertanggung jawab mengatur alur kerja tim dan merancang antarmuka pengguna.</p>
                <div class="links">
                    <a href="https://github.com/" target="_blank">GitHub</a>
                    <a href="https://instagram.com/" target="_blank">Instagram</a>
                </div>
            </div>

            <!-- Anggota 2 -->
            <div class="card">
                <img src="img/anggota2.jpg" alt="Foto Anggota 2">
                <h2>Nama Anggota 2</h2>
                <span class="role">UI/UX Designer</span>
                <p>Merancang sketsa tampilan, pemilihan warna, dan kenyamanan navigasi website.</p>
                <div class="links">
                    <a href="https://github.com/" target="_blank">GitHub</a>
                    <a href="https://instagram.com/" target="_blank">Instagram</a>
                </div>
            </div>

            <!-- Anggota 3 -->
            <div class="card">
                <img src="img/anggota3.jpg" alt="Foto Anggota 3">
                <h2>Nama Anggota 3</h2>
                <span class="role">Backend Developer</span>
                <p>Mengelola struktur data, logika program, serta integrasi sistem.</p>
                <div class="links">
                    <a href="https://github.com/" target="_blank">GitHub</a>
                    <a href="https://instagram.com/" target="_blank">Instagram</a>
                </div>
            </div>

            <!-- Anggota 4 -->
            <div class="card">
                <img src="img/anggota4.jpg" alt="Foto Anggota 4">
                <h2>Nama Anggota 4</h2>
                <span class="role">Content Writer</span>
                <p>Menyusun seluruh teks, deskripsi proyek, dan dokumentasi tertulis.</p>
                <div class="links">
                    <a href="https://github.com/" target="_blank">GitHub</a>
                    <a href="https://instagram.com/" target="_blank">Instagram</a>
                </div>
            </div>

            <!-- Anggota 5 -->
            <div class="card">
                <img src="img/anggota5.jpg" alt="Foto Anggota 5">
                <h2>Nama Anggota 5</h2>
                <span class="role">Quality Assurance</span>
                <p>Menguji tampilan website di berbagai ukuran layar agar bebas dari error.</p>
                <div class="links">
                    <a href="https://github.com/" target="_blank">GitHub</a>
                    <a href="https://instagram.com/" target="_blank">Instagram</a>
                </div>
            </div>

            <!-- Anggota 6 -->
            <div class="card">
                <img src="img/anggota6.jpg" alt="Foto Anggota 6">
                <h2>Nama Anggota 6</h2>
                <span class="role">Media & Aset Visual</span>
                <p>Mengumpulkan dan mengedit foto, ikon, serta aset grafis pendukung.</p>
                <div class="links">
                    <a href="https://github.com/" target="_blank">GitHub</a>
                    <a href="https://instagram.com/" target="_blank">Instagram</a>
                </div>
            </div>

        </section>
    </main>

    <footer>
        <p>&copy; 2026 Kelompok 1. Dibuat menggunakan HTML & CSS di GitHub Pages.</p>
    </footer>

</body>
</html>
